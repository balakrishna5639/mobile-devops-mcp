{
  "name": "mobile-devops-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing mobile DevOps workflows as agent-callable tools — Cordova config generation, Android build diagnostics, and iOS code signing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mobile-devops-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-mcp": "tsx test/mcp-client.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mobile",
    "cordova",
    "phonegap",
    "android",
    "ios",
    "devops",
    "ai",
    "agent",
    "smythos",
    "code-signing",
    "build-diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balakrishna5639/mobile-devops-mcp.git"
  },
  "homepage": "https://github.com/balakrishna5639/mobile-devops-mcp#readme",
  "author": "Balakrishna",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@smythos/sdk": "^1.2.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
